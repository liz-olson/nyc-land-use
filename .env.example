# Copy this file to .env and fill in values. .env is gitignored; never commit real secrets.
# In GitHub Actions, these are set as repository secrets instead.

# Path to the local DuckDB warehouse file (relative to the repo root)
DUCKDB_PATH=data/warehouse.duckdb

# NYC Open Data app token (Phase 1): https://data.cityofnewyork.us/profile/edit/developer_settings
SOCRATA_APP_TOKEN=
